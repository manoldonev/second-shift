@@ -0,0 +1,40 @@
+#### Fix comments print on class methods with decorators (#16891 by @fisker)
+
+<!-- prettier-ignore -->
+```jsx
+// Input
+class A {
+  @decorator
+  /**
+   * The method description
+   *
+  */
+  async method(foo: Foo, bar: Bar) {
+    console.log(foo);
+  }
+}
+
+// Prettier stable
+class A {
+  @decorator
+  async /**
+   * The method description
+   *
+   */
+  method(foo: Foo, bar: Bar) {
+    console.log(foo);
+  }
+}
+
+// Prettier main
+class A {
+  @decorator
+  /**
+   * The method description
+   *
+   */
+  async method(foo: Foo, bar: Bar) {
+    console.log(foo);
+  }
+}
+```
