index 000000000..1671b17bf
--- /dev/null
+++ b/tests/integration/__tests__/print-pre-check.js
@@ -0,0 +1,110 @@
+import prettier from "../../config/prettier-entry.js";
+
+const NON_NODE_ERROR = "Calling `print()` on non-node object.";
+
+let pluginCount = 0;
+function createPlugin(print, getVisitorKeys) {
+  // parsers leak across tests, so the name needs to be unique
+  const name = `print-pre-check-${pluginCount++}`;
+  return {
+    name,
+    plugin: {
+      parsers: {
+        [name]: {
+          parse: (text) => ({
+            type: "root",
+            text,
+            body: { type: "body", text },
+          }),
+          astFormat: name,
+        },
+      },
+      printers: {
+        [name]: { print, getVisitorKeys },
+      },
+    },
+  };
+}
+
+const visitorKeys = {
+  root: ["body", "missing"],
+  body: [],
+};
+
+function format(text, print, getVisitorKeys) {
+  const { name, plugin } = createPlugin(print, getVisitorKeys);
+  return prettier.format(text, { parser: name, plugins: [plugin] });
+}
+
+test("print() on a child node passes the check", async () => {
+  const result = await format(
+    "foo",
+    (path, options, print) => {
+      const node = path.getValue();
+      return node.type === "root" ? print("body") : node.text;
+    },
+    (node) => visitorKeys[node.type]
+  );
+
+  expect(result).toBe("foo");
+});
+
+test("print() on a string property throws", async () => {
+  await expect(
+    format(
+      "foo",
+      (path, options, print) => print("text"),
+      (node) => visitorKeys[node.type]
+    )
+  ).rejects.toThrow(NON_NODE_ERROR);
+});
+
+test("print() on a missing property throws when it is not a child key", async () => {
+  await expect(
+    format(
+      "foo",
+      (path, options, print) => {
+        const node = path.getValue();
+        return node.type === "root" ? print("notAChild") : node.text;
+      },
+      (node) => visitorKeys[node.type]
+    )
+  ).rejects.toThrow(NON_NODE_ERROR);
+});
+
+test("print() on a missing child key prints nothing", async () => {
+  const result = await format(
+    "foo",
+    (path, options, print) => {
+      const node = path.getValue();
+      return node.type === "root" ? [print("missing"), print("body")] : "bar";
+    },
+    (node) => visitorKeys[node.type]
+  );
+
+  expect(result).toBe("bar");
+});
+
+test("a printer without getVisitorKeys checks against the node's own keys", async () => {
+  const print = (path, options, print) => {
+    const node = path.getValue();
+    return node.type === "root" ? print("body") : node.text;
+  };
+
+  await expect(format("foo", print)).resolves.toBe("foo");
+  await expect(
+    format("foo", (path, options, print) => print("notAChild"))
+  ).rejects.toThrow(NON_NODE_ERROR);
+});
+
+describe("built-in printers pass the check", () => {
+  test.each([
+    ["typescript", "abstract class A {\n  abstract a: string;\n  b = 1;\n}\n"],
+    ["babel-ts", "abstract class A {\n  abstract a: string;\n  b = 1;\n}\n"],
+    ["graphql", "extend input A {\n  a: String\n}\n"],
+    ["graphql", '"""\nDescription\n"""\ninterface A implements B {\n  a: String\n}\n'],
+    ["graphql", "type A {\n  a: String\n}\n\nunion B = A\n\nscalar C\n"],
+  ])("%s", async (parser, input) => {
+    await expect(prettier.format(input, { parser })).resolves.toBe(input);
+  });
+});
