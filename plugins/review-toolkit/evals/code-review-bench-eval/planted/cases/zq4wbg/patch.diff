@@ -0,0 +1,34 @@
+#### Fix inconsistent formatting for multiline strings (#13274 by @GlebDolzhikov)
+
+<!-- prettier-ignore -->
+```jsx
+// Input
+const loremIpsumFooBazBar1 = 'Multiline string\
+         Multiline string\
+'
+
+const loremIpsumFooBazBar2 = 'Multiline string\
+         Multiline string\
+         Multiline string'
+
+// Prettier stable
+const loremIpsumFooBazBar1 = "Multiline string\
+         Multiline string\
+";
+
+const loremIpsumFooBazBar2 =
+  "Multiline string\
+         Multiline string\
+         Multiline string";
+
+// Prettier main
+const loremIpsumFooBazBar1 =
+  "Multiline string\
+         Multiline string\
+";
+
+const loremIpsumFooBazBar2 =
+  "Multiline string\
+         Multiline string\
+         Multiline string";
+```
