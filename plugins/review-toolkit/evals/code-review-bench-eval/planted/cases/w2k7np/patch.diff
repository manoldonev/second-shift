@@ -371,3 +347,23 @@ function createApp() {

   return app;
 }
+
+function createAppForCaching(cache) {
+  var app = express();
+  app.count = 0;
+
+  function View(name, options){
+    this.name = name;
+    this.path = 'fake';
+    app.count++;
+  }
+
+  View.prototype.render = function(options, fn){
+    fn(null, 'abstract engine');
+  };
+
+  app.set('view cache', !!cache);
+  app.set('view', View);
+
+  return app;
+}
