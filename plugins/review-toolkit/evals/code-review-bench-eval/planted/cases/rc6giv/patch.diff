+++ b/changelog_unreleased/javascript/12260.md
@@ -0,0 +1,24 @@
+#### Add parens to `ClassExpression` with decorators (#12260 by @fisker)
+
+<!-- prettier-ignore -->
+```js
+// Input
+(@f() class {});
+
+// Prettier stable
+@f()
+class {};
+
+// Prettier stable (Second format)
+SyntaxError: A class name is required. (2:7)
+  1 | @f()
+> 2 | class {};
+    |       ^
+  3 |
+
+// Prettier main
+(
+  @f()
+  class {}
+);
+```
