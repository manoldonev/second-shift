+import { dirname, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, test, vi } from 'vitest'
+import type { Logger } from '../../logger'
+import { injectSourcesContent } from '../sourcemap'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+const file = resolve(__dirname, 'fixtures/sourcemap/lib/index.js')
+const presentContent = "export const present: string = 'on disk'\n"
+
+function createLogger() {
+  const warnOnce = vi.fn()
+  const logger = { warnOnce } as unknown as Logger
+  return { logger, warnOnce }
+}
+
+describe('injectSourcesContent', () => {
+  test('keeps content the map already carries for a source that is not on disk', async () => {
+    const { logger, warnOnce } = createLogger()
+    const map = {
+      sources: ['../src/missing.ts'],
+      sourcesContent: ["export const shipped = 'only in the map'\n"],
+    }
+    await injectSourcesContent(map, file, logger)
+    expect(map.sourcesContent).toEqual([
+      "export const shipped = 'only in the map'\n",
+    ])
+    expect(warnOnce).not.toHaveBeenCalled()
+  })
+
+  test('fills a null entry from the source file and keeps the others', async () => {
+    const { logger, warnOnce } = createLogger()
+    const map = {
+      sources: ['../src/present.ts', '../src/missing.ts'],
+      sourcesContent: [null, "export const shipped = 'only in the map'\n"],
+    }
+    await injectSourcesContent(map, file, logger)
+    expect(map.sourcesContent).toEqual([
+      presentContent,
+      "export const shipped = 'only in the map'\n",
+    ])
+    expect(warnOnce).not.toHaveBeenCalled()
+  })
+
+  test('reads every source when the map carries no content', async () => {
+    const { logger, warnOnce } = createLogger()
+    const map: { sources: string[]; sourcesContent?: (string | null)[] } = {
+      sources: ['../src/present.ts'],
+    }
+    await injectSourcesContent(map, file, logger)
+    expect(map.sourcesContent).toEqual([presentContent])
+    expect(warnOnce).not.toHaveBeenCalled()
+  })
+
+  test('resolves sources against sourceRoot', async () => {
+    const { logger } = createLogger()
+    const map = {
+      sources: ['present.ts'],
+      sourceRoot: '../src',
+      sourcesContent: [null],
+    }
+    await injectSourcesContent(map, file, logger)
+    expect(map.sourcesContent).toEqual([presentContent])
+  })
+
+  test('warns once for a source that is neither carried nor on disk', async () => {
+    const { logger, warnOnce } = createLogger()
+    const map = {
+      sources: ['../src/present.ts', '../src/missing.ts'],
+      sourcesContent: [null, null],
+    }
+    await injectSourcesContent(map, file, logger)
+    expect(map.sourcesContent).toEqual([presentContent, null])
+    expect(warnOnce).toHaveBeenCalledTimes(1)
+    expect(warnOnce).toHaveBeenCalledWith(
+      `Sourcemap for "${file}" points to missing source files`,
+    )
+  })
+
+  test('leaves virtual sources empty without a warning', async () => {
+    const { logger, warnOnce } = createLogger()
+    const map = {
+      sources: ['\0virtual-module', 'virtual:entry'],
+    } as { sources: string[]; sourcesContent?: (string | null)[] }
+    await injectSourcesContent(map, file, logger)
+    expect(map.sourcesContent).toEqual([null, null])
+    expect(warnOnce).not.toHaveBeenCalled()
+  })
+})
