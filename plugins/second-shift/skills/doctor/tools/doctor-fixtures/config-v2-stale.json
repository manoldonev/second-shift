{
  "configVersion": 2,
  "tracker": { "type": "jira" },
  "topology": { "type": "standalone", "repos": { "app": { "path": ".", "baseBranch": "main" } } },
  "gates": { "mutation": false },
  "stageParams": { "webComponentGlobs": ["src/**/*.tsx"] },
  "grillWaivers": { "T4.design-liverender": "declined" },
  "commands": { "app": { "lint": "yarn lint", "test": "yarn test" } },
  "design": { "provider": "figma", "liveRender": { "command": "yarn render --route {route} --out {out}", "cwd": "app", "tolerancePx": 2 } }
}
