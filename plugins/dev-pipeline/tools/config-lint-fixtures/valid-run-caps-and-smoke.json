{
  "$schema": "https://raw.githubusercontent.com/manoldonev/second-shift/v2.1.0/schema/second-shift.config.schema.json",
  "configVersion": 3,
  "tracker": {
    "type": "github"
  },
  "commands": {
    "app": {
      "lint": "yarn lint",
      "test": "yarn test"
    }
  },
  "run": {
    "maxRounds": 2,
    "checksRedMax": 2,
    "buildTimeoutSeconds": 600,
    "reviewTimeoutSeconds": 600,
    "costCeilingUsd": 40
  },
  "design": {
    "provider": "figma",
    "liveRender": {
      "command": "yarn render:verify --route {route} --out {out}",
      "smokeCommand": "yarn render:smoke --route {route} --expect {mustShow}"
    }
  }
}
