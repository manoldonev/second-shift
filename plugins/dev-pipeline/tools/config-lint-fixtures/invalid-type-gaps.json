{
  "configVersion": 3,
  "tracker": {
    "type": "github",
    "bot": {
      "enabled": "yes"
    }
  },
  "commands": {
    "host": {
      "lanes": [
        {
          "name": "install",
          "cwd": 5,
          "commands": "yarn install"
        },
        {
          "name": "build",
          "commands": []
        }
      ],
      "extraLanes": [
        {
          "name": "e2e",
          "when": "changed",
          "commands": [
            "yarn e2e"
          ],
          "failureClass": "INFRA"
        }
      ]
    }
  },
  "reviewers": {
    "remove": "security-reviewer",
    "webComponentGlobs": "src/**/*.vue"
  },
  "paths": {
    "plansDir": 5
  },
  "implementDelegates": [
    {
      "surface": "unit",
      "agent": "acme-unit-author"
    }
  ]
}
