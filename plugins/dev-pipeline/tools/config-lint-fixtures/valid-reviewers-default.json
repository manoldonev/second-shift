{
  "configVersion": 3,
  "tracker": {
    "type": "github"
  },
  "commands": {
    "app": {
      "lint": "yarn lint",
      "test": "yarn test"
    }
  },
  "reviewers": {
    "default": [
      "security-reviewer",
      "unit-test-mutation-reviewer"
    ],
    "remove": [
      "db-reviewer"
    ]
  }
}
