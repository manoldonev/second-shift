{
  "configVersion": 3,
  "baseBranch": "develop",
  "tracker": {
    "type": "github",
    "writes": true,
    "keyPattern": "[0-9]+",
    "branchPrefix": "claude/acme-",
    "bot": {
      "enabled": true,
      "envVar": "GH_BOT",
      "wrapperPath": "~/.config/acme/gh-as-bot.sh",
      "app": {
        "clientId": "Iv1EXAMPLECLIENTID000",
        "appName": "acme-dev-pipeline",
        "privateKeyFilename": "acme-dev-pipeline.private-key.pem"
      }
    }
  },
  "commands": {
    "mono": {
      "lint": "yarn lint",
      "typecheck": "yarn typecheck",
      "test": "yarn test",
      "format": "yarn format",
      "lanes": [
        {
          "name": "apps",
          "cwd": "apps",
          "commands": [
            "yarn workspaces foreach -pt run ci"
          ]
        },
        {
          "name": "packages",
          "cwd": "packages",
          "commands": [
            "yarn workspaces foreach -pt run build"
          ]
        }
      ],
      "extraLanes": [
        {
          "name": "contract-tests",
          "when": [
            "src/modules/**"
          ],
          "commands": [
            "yarn contract:test"
          ],
          "failureClass": "TEST_FAILURE"
        }
      ]
    }
  },
  "reviewers": {
    "add": [
      {
        "name": "orders-reviewer",
        "dimensions": [
          "domain-orders"
        ]
      }
    ],
    "modelOverrides": {
      "security-reviewer": "opus"
    },
    "webComponentGlobs": [
      "apps/web/**/*.{tsx,jsx}"
    ]
  },
  "design": {
    "provider": "claude-design"
  }
}
