{
  "configVersion": 2,
  "tracker": { "type": "github", "branchPrefix": "claude/app-" },
  "topology": { "type": "standalone", "repos": { "app": { "path": ".", "baseBranch": "main" } } },
  "commands": { "app": { "lint": "yarn lint", "test": "yarn test" } },
  "design": {
    "provider": "figma",
    "liveRender": { "command": "yarn render:verify --route {route} --out {out}", "tolerancePx": -1 }
  }
}
